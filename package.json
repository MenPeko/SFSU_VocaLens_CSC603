{
  "name": "vocalens",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "dev-start": "bash scripts/dev-start.sh",
    "dev-stop": "bash scripts/dev-stop.sh",
    "dev-restart": "bash scripts/dev-restart.sh",
    "sign:export-dataset": ".venv/bin/python -m sign_classifier_service.export_dataset",
    "sign:train-model": ".venv/bin/python -m sign_classifier_service.train",
    "sign:evaluate-model": ".venv/bin/python -m sign_classifier_service.evaluate",
    "sign:report-model": "bash scripts/report-model.sh",
    "sign:eval-sessions": ".venv/bin/python -m sign_classifier_service.eval.sessions list",
    "sign:eval-extract-install": "cd scripts/sign-extract && bun install",
    "sign:eval-extract": "bun scripts/sign-extract/extract-videos.ts",
    "sign:eval-run": ".venv/bin/python -m sign_classifier_service.eval.run",
    "sign:eval-summarize": ".venv/bin/python -m sign_classifier_service.eval.summarize"
  },
  "dependencies": {
    "@mediapipe/holistic": "0.5.1675471629",
    "@mediapipe/hands": "0.4.1675469240",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fingerpose": "github:andypotato/fingerpose",
    "lucide-react": "^0.545.0",
    "react": "^19",
    "react-dom": "^19",
    "sign-translate": "github:sign/translate",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
